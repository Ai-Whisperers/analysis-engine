# Environment Configuration Example
# Copy this file to .env and configure for your environment

# Environment
ENVIRONMENT=development  # development, test, production
DEBUG=true
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR

# File Upload
MAX_UPLOAD_SIZE_MB=100

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=20

# Security
API_KEY=  # Optional API key for authentication
ALLOWED_ORIGINS=*  # CORS allowed origins (comma-separated)

# Telemetry
JAEGER_AGENT_HOST=jaeger  # Jaeger tracing host (optional)
JAEGER_AGENT_PORT=6831
OTEL_CONSOLE_EXPORT=false  # Enable console export for debugging

# Performance
ONNX_NUM_THREADS=  # Number of threads for ONNX (default: CPU count)
POLARS_NUM_THREADS=  # Number of threads for Polars (default: CPU count)

# Paths
MODELS_DIR=models
DATA_DIR=data
UPLOAD_DIR=uploads

# Database
# (No external database needed - uses sharded SQLite)

# Production-specific
GRAFANA_PASSWORD=changeme  # Change in production!
